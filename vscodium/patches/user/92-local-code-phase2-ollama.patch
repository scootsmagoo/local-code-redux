+/*---------------------------------------------------------------------------------------------
+ *  Copyright (c) Local Code contributors. All rights reserved.
+ *  Licensed under the MIT License.
+ *--------------------------------------------------------------------------------------------*/
+
+import { AsyncIterableSource, DeferredPromise } from '../../../../base/common/async.js';
+import { CancellationToken } from '../../../../base/common/cancellation.js';
+import { Emitter } from '../../../../base/common/event.js';
+import { Disposable } from '../../../../base/common/lifecycle.js';
+import { localize } from '../../../../nls.js';
+import { IConfigurationService } from '../../../../platform/configuration/common/configuration.js';
+import { ExtensionIdentifier } from '../../../../platform/extensions/common/extensions.js';
+import { ILogService } from '../../../../platform/log/common/log.js';
+import { IRequestService } from '../../../../platform/request/common/request.js';
+import { ChatAgentLocation } from '../../chat/common/constants.js';
+import {
+	ChatMessageRole,
+	IChatMessage,
+	IChatResponsePart,
+	ILanguageModelChatInfoOptions,
+	ILanguageModelChatMetadataAndIdentifier,
+	ILanguageModelChatProvider,
+	ILanguageModelChatRequestOptions,
+	ILanguageModelChatResponse,
+} from '../../chat/common/languageModels.js';
+import { modelIdentifier, modelNameFromIdentifier, OllamaChatMessage, OllamaClient, OLLAMA_VENDOR } from './ollamaClient.js';
+
+const LOCAL_CODE_OLLAMA_EXTENSION = new ExtensionIdentifier('local-code.ollama');
+
+export const LocalCodeOllamaSettings = {
+	endpoint: 'localCode.ollama.endpoint',
+	defaultModel: 'localCode.ollama.defaultModel',
+	requestTimeoutMs: 'localCode.ollama.requestTimeoutMs',
+	maxOutputTokens: 'localCode.ollama.maxOutputTokens',
+} as const;
+
+export class OllamaLanguageModelProvider extends Disposable implements ILanguageModelChatProvider {
+
+	private readonly _onDidChange = this._register(new Emitter<void>());
+	readonly onDidChange = this._onDidChange.event;
+
+	private readonly _client: OllamaClient;
+
+	constructor(
+		@IRequestService requestService: IRequestService,
+		@ILogService logService: ILogService,
+		@IConfigurationService private readonly _configurationService: IConfigurationService,
+	) {
+		super();
+		this._client = new OllamaClient(requestService, logService);
+	}
+
+	refresh(): void {
+		this._onDidChange.fire();
+	}
+
+	async provideLanguageModelChatInfo(_options: ILanguageModelChatInfoOptions, token: CancellationToken): Promise<ILanguageModelChatMetadataAndIdentifier[]> {
+		const endpoint = this._configurationService.getValue<string>(LocalCodeOllamaSettings.endpoint) ?? 'http://127.0.0.1:11434';
+		const defaultModel = this._configurationService.getValue<string>(LocalCodeOllamaSettings.defaultModel) ?? '';
+		const timeoutMs = this._configurationService.getValue<number>(LocalCodeOllamaSettings.requestTimeoutMs) ?? 120_000;
+
+		let models: { name: string }[];
+		try {
+			models = await this._client.listModels(endpoint, timeoutMs, token);
+		} catch (err) {
+			throw new Error(localize('localCode.ollama.listFailed', "Could not reach Ollama at {0}. Is it running? {1}", endpoint, String(err)));
+		}
+
+		if (models.length === 0) {
+			throw new Error(localize('localCode.ollama.noModels', "Ollama is running but no models are installed. Run `ollama pull` to add a model."));
+		}
+
+		const defaultName = defaultModel && models.some(m => m.name === defaultModel)
+			? defaultModel
+			: models[0].name;
+
+		return models.map(m => {
+			const isDefault = m.name === defaultName;
+			return {
+				identifier: modelIdentifier(m.name),
+				metadata: {
+					extension: LOCAL_CODE_OLLAMA_EXTENSION,
+					name: m.name,
+					id: m.name,
+					vendor: OLLAMA_VENDOR,
+					family: m.name,
+					version: '1',
+					maxInputTokens: 128_000,
+					maxOutputTokens: this._configurationService.getValue<number>(LocalCodeOllamaSettings.maxOutputTokens) ?? 4096,
+					isDefaultForLocation: isDefault ? {
+						[ChatAgentLocation.Chat]: true,
+						[ChatAgentLocation.EditorInline]: true,
+						[ChatAgentLocation.Terminal]: true,
+						[ChatAgentLocation.Notebook]: true,
+					} : {},
+					isUserSelectable: true,
+					modelPickerCategory: { label: localize('localCode.ollama.category', "Local (Ollama)"), order: 0 },
+					capabilities: {
+						toolCalling: false,
+						agentMode: false,
+					},
+				},
+			};
+		});
+	}
+
+	async sendChatRequest(
+		modelId: string,
+		messages: IChatMessage[],
+		_from: ExtensionIdentifier | undefined,
+		_options: ILanguageModelChatRequestOptions,
+		token: CancellationToken,
+	): Promise<ILanguageModelChatResponse> {
+		const endpoint = this._configurationService.getValue<string>(LocalCodeOllamaSettings.endpoint) ?? 'http://127.0.0.1:11434';
+		const timeoutMs = this._configurationService.getValue<number>(LocalCodeOllamaSettings.requestTimeoutMs) ?? 120_000;
+		const maxOutputTokens = this._configurationService.getValue<number>(LocalCodeOllamaSettings.maxOutputTokens) ?? 4096;
+		const modelName = modelNameFromIdentifier(modelId);
+		const ollamaMessages = this._toOllamaMessages(messages);
+
+		const defer = new DeferredPromise<void>();
+		const stream = new AsyncIterableSource<IChatResponsePart>();
+
+		(async () => {
+			try {
+				await this._client.streamChat(
+					endpoint,
+					modelName,
+					ollamaMessages,
+					maxOutputTokens,
+					timeoutMs,
+					text => stream.emitOne({ type: 'text', value: text }),
+					token,
+				);
+				stream.resolve();
+				defer.complete(undefined);
+			} catch (err) {
+				const error = err instanceof Error ? err : new Error(String(err));
+				stream.reject(error);
+				defer.error(error);
+			}
+		})();
+
+		return { stream: stream.asyncIterable, result: defer.p };
+	}
+
+	async provideTokenCount(_modelId: string, message: string | IChatMessage, _token: CancellationToken): Promise<number> {
+		const text = typeof message === 'string'
+			? message
+			: message.content.filter(p => p.type === 'text').map(p => p.value).join('');
+		return Math.ceil(text.length / 4);
+	}
+
+	private _toOllamaMessages(messages: IChatMessage[]): OllamaChatMessage[] {
+		const result: OllamaChatMessage[] = [];
+		for (const message of messages) {
+			const text = message.content
+				.filter(p => p.type === 'text')
+				.map(p => p.value)
+				.join('\n');
+			if (!text) {
+				continue;
+			}
+			switch (message.role) {
+				case ChatMessageRole.System:
+					result.push({ role: 'system', content: text });
+					break;
+				case ChatMessageRole.User:
+					result.push({ role: 'user', content: text });
+					break;
+				case ChatMessageRole.Assistant:
+					result.push({ role: 'assistant', content: text });
+					break;
+			}
+		}
+		return result;
+	}
+}
