+/*---------------------------------------------------------------------------------------------
+ *  Copyright (c) Local Code contributors. All rights reserved.
+ *  Licensed under the MIT License.
+ *--------------------------------------------------------------------------------------------*/
+
+import { VSBuffer } from '../../../../base/common/buffer.js';
+import { CancellationToken } from '../../../../base/common/cancellation.js';
+import { listenStream } from '../../../../base/common/stream.js';
+import { ILogService } from '../../../../platform/log/common/log.js';
+import { asJson, IRequestService, isSuccess } from '../../../../platform/request/common/request.js';
+
+export const OLLAMA_VENDOR = 'ollama';
+
+export interface OllamaModelInfo {
+	readonly name: string;
+}
+
+interface OllamaTagsResponse {
+	readonly models?: Array<{ readonly name: string }>;
+}
+
+export interface OllamaChatMessage {
+	readonly role: 'system' | 'user' | 'assistant';
+	readonly content: string;
+}
+
+export function normalizeOllamaEndpoint(endpoint: string): string {
+	return endpoint.replace(/\/+$/, '');
+}
+
+export function modelNameFromIdentifier(modelId: string): string {
+	const prefix = `${OLLAMA_VENDOR}/`;
+	if (modelId.startsWith(prefix)) {
+		return modelId.slice(prefix.length);
+	}
+	return modelId;
+}
+
+export function modelIdentifier(modelName: string): string {
+	return `${OLLAMA_VENDOR}/${modelName}`;
+}
+
+export class OllamaClient {
+
+	constructor(
+		private readonly _requestService: IRequestService,
+		private readonly _logService: ILogService,
+	) { }
+
+	async listModels(endpoint: string, timeoutMs: number, token: CancellationToken): Promise<OllamaModelInfo[]> {
+		const url = `${normalizeOllamaEndpoint(endpoint)}/api/tags`;
+		const context = await this._requestService.request({
+			type: 'GET',
+			url,
+			timeout: timeoutMs,
+			callSite: 'localCode.ollama.listModels',
+		}, token);
+
+		if (!isSuccess(context)) {
+			throw new Error(`Ollama tags request failed (${context.res.statusCode ?? 'unknown'})`);
+		}
+
+		const body = await asJson<OllamaTagsResponse>(context);
+		return (body?.models ?? []).map(m => ({ name: m.name }));
+	}
+
+	async streamChat(
+		endpoint: string,
+		model: string,
+		messages: OllamaChatMessage[],
+		maxOutputTokens: number,
+		timeoutMs: number,
+		onText: (chunk: string) => void,
+		token: CancellationToken,
+	): Promise<void> {
+		const url = `${normalizeOllamaEndpoint(endpoint)}/api/chat`;
+		const context = await this._requestService.request({
+			type: 'POST',
+			url,
+			headers: { 'Content-Type': 'application/json' },
+			data: JSON.stringify({
+				model,
+				messages,
+				stream: true,
+				options: { num_predict: maxOutputTokens },
+			}),
+			timeout: timeoutMs,
+			callSite: 'localCode.ollama.streamChat',
+		}, token);
+
+		if (!isSuccess(context)) {
+			throw new Error(`Ollama chat request failed (${context.res.statusCode ?? 'unknown'})`);
+		}
+
+		let buffer = '';
+
+		await new Promise<void>((resolve, reject) => {
+			listenStream(context.stream, {
+				onData: chunk => {
+					const bytes = chunk instanceof VSBuffer ? chunk : VSBuffer.wrap(chunk);
+					buffer += bytes.toString();
+					let newlineIndex: number;
+					while ((newlineIndex = buffer.indexOf('\n')) >= 0) {
+						const line = buffer.slice(0, newlineIndex).trim();
+						buffer = buffer.slice(newlineIndex + 1);
+						if (!line) {
+							continue;
+						}
+						try {
+							const parsed = JSON.parse(line) as { message?: { content?: string }; done?: boolean };
+							const text = parsed.message?.content;
+							if (text) {
+								onText(text);
+							}
+						} catch (err) {
+							this._logService.warn(`[Local Code Ollama] Failed to parse stream line: ${line}`, err);
+						}
+					}
+				},
+				onError: err => reject(err),
+				onEnd: () => resolve(),
+			}, token);
+		});
+	}
+}
