@@ -0,0 +1,37 @@
+/*---------------------------------------------------------------------------------------------
+ *  Copyright (c) Local Code contributors. All rights reserved.
+ *  Licensed under the MIT License.
+ *--------------------------------------------------------------------------------------------*/
+
+import { localize } from '../../../../nls.js';
+
+/** Prepended to every Ollama chat request so local models behave like a coding assistant. */
+export const LOCAL_CODE_OLLAMA_SYSTEM_PROMPT = localize(
+	'localCode.ollama.systemPrompt',
+	"You are a helpful coding assistant in Local Code. Answer questions about software development clearly and professionally. "
+	+ "Write code when asked. Stay on topic. Do not produce random word lists, slurs, or unrelated content. "
+	+ "If you cannot help, say so briefly.",
+);
+
+/** Prefer these name patterns when choosing the default Ollama model (first match wins). */
+export const PREFERRED_OLLAMA_DEFAULT_MODEL_PATTERNS: readonly RegExp[] = [
+	/^llama3\.1:/i,
+	/^llama3\.2:/i,
+	/^llama3:/i,
+	/^qwen2\.5-coder:(?!.*base)/i,
+	/^qwen2\.5:/i,
+	/^deepseek/i,
+];
+
+export function pickPreferredOllamaModelName(models: readonly { readonly name: string }[], configuredDefault: string): string {
+	if (configuredDefault && models.some(m => m.name === configuredDefault)) {
+		return configuredDefault;
+	}
+	for (const pattern of PREFERRED_OLLAMA_DEFAULT_MODEL_PATTERNS) {
+		const match = models.find(m => pattern.test(m.name));
+		if (match) {
+			return match.name;
+		}
+	}
+	return models[0]?.name ?? '';
+}

