@@ -0,0 +1,214 @@
+/*---------------------------------------------------------------------------------------------
+ *  Copyright (c) Local Code contributors. All rights reserved.
+ *  Licensed under the MIT License.
+ *--------------------------------------------------------------------------------------------*/
+
+import { Codicon } from '../../../../base/common/codicons.js';
+import { CancellationToken } from '../../../../base/common/cancellation.js';
+import { MarkdownString } from '../../../../base/common/htmlContent.js';
+import { Disposable, DisposableStore, IDisposable } from '../../../../base/common/lifecycle.js';
+import { ThemeIcon } from '../../../../base/common/themables.js';
+import { localize } from '../../../../nls.js';
+import { ILogService } from '../../../../platform/log/common/log.js';
+import { nullExtensionDescription } from '../../../services/extensions/common/extensions.js';
+import { IInstantiationService } from '../../../../platform/instantiation/common/instantiation.js';
+import { IChatAgentImplementation, IChatAgentHistoryEntry, IChatAgentRequest, IChatAgentResult, IChatAgentService } from '../../chat/common/participants/chatAgents.js';
+import { ChatMode } from '../../chat/common/chatModes.js';
+import { IChatProgress, IChatTaskDto } from '../../chat/common/chatService/chatService.js';
+import { IChatProgressHistoryResponseContent } from '../../chat/common/model/chatModel.js';
+import { ChatAgentLocation, ChatModeKind } from '../../chat/common/constants.js';
+import { ChatMessageRole, IChatMessage, ILanguageModelsService } from '../../chat/common/languageModels.js';
+import { OLLAMA_VENDOR } from './ollamaClient.js';
+import { LOCAL_CODE_OLLAMA_SYSTEM_PROMPT } from './localCodeSystemPrompt.js';
+
+export const LOCAL_CODE_CHAT_AGENT_IDS = {
+	chat: 'localcode.chat',
+	edits: 'localcode.edits',
+	agent: 'localcode.agent',
+	terminal: 'localcode.terminal',
+	editor: 'localcode.editor',
+	notebook: 'localcode.notebook',
+} as const;
+
+const HELP_TEXT = new MarkdownString(localize(
+	'localCode.chat.help',
+	"Chat uses **Ollama** on this machine (`http://127.0.0.1:11434`). No sign-in. Use the **model picker** next to the input (shows the model name, e.g. llama3.1:8b) — not the **Local** session button.",
+));
+HELP_TEXT.isTrusted = true;
+
+export class LocalCodeChatAgent extends Disposable implements IChatAgentImplementation {
+
+	constructor(
+		@ILanguageModelsService private readonly _languageModelsService: ILanguageModelsService,
+		@ILogService private readonly _logService: ILogService,
+	) {
+		super();
+	}
+
+	async invoke(
+		request: IChatAgentRequest,
+		progress: (parts: IChatProgress[]) => void,
+		history: IChatAgentHistoryEntry[],
+		token: CancellationToken,
+	): Promise<IChatAgentResult> {
+		const modelId = await this._resolveModelId(request.userSelectedModelId, token);
+		if (!modelId) {
+			progress([{
+				kind: 'markdownContent',
+				content: new MarkdownString(localize(
+					'localCode.chat.noModel',
+					"No Ollama model is available. Start the **Ollama** app (menu bar), run `ollama pull <model>` if needed, then pick a model in the chat model dropdown.",
+				)),
+			}]);
+			return {};
+		}
+
+		const messages = this._buildMessages(request, history);
+
+		try {
+			const response = await this._languageModelsService.sendChatRequest(modelId, undefined, messages, {}, token);
+			for await (const part of response.stream) {
+				if (token.isCancellationRequested) {
+					break;
+				}
+				const chunk = extractTextChunk(part);
+				if (chunk) {
+					progress([{ kind: 'markdownContent', content: new MarkdownString(chunk) }]);
+				}
+			}
+			await response.result;
+		} catch (err) {
+			const detail = err instanceof Error ? err.message : String(err);
+			this._logService.warn(`[Local Code] Chat request failed: ${detail}`);
+			progress([{
+				kind: 'markdownContent',
+				content: new MarkdownString(localize(
+					'localCode.chat.error',
+					"Could not get a response from Ollama. Is the Ollama app running? {0}",
+					detail,
+				)),
+			}]);
+		}
+
+		return {};
+	}
+
+	private async _resolveModelId(userSelectedModelId: string | undefined, token: CancellationToken): Promise<string | undefined> {
+		if (userSelectedModelId && this._languageModelsService.lookupLanguageModel(userSelectedModelId)) {
+			return userSelectedModelId;
+		}
+
+		for (const id of this._languageModelsService.getLanguageModelIds()) {
+			const model = this._languageModelsService.lookupLanguageModel(id);
+			if (model?.vendor === OLLAMA_VENDOR && model.isUserSelectable) {
+				return id;
+			}
+		}
+
+		const ids = await this._languageModelsService.selectLanguageModels({ vendor: OLLAMA_VENDOR });
+		if (token.isCancellationRequested) {
+			return undefined;
+		}
+		return ids[0];
+	}
+
+	private _buildMessages(request: IChatAgentRequest, history: IChatAgentHistoryEntry[]): IChatMessage[] {
+		const messages: IChatMessage[] = [{
+			role: ChatMessageRole.System,
+			content: [{ type: 'text', value: LOCAL_CODE_OLLAMA_SYSTEM_PROMPT }],
+		}];
+
+		for (const entry of history) {
+			if (entry.request.message) {
+				messages.push({
+					role: ChatMessageRole.User,
+					content: [{ type: 'text', value: entry.request.message }],
+				});
+			}
+			const assistantText = historyResponseToText(entry.response);
+			if (assistantText) {
+				messages.push({
+					role: ChatMessageRole.Assistant,
+					content: [{ type: 'text', value: assistantText }],
+				});
+			}
+		}
+
+		if (request.message) {
+			messages.push({
+				role: ChatMessageRole.User,
+				content: [{ type: 'text', value: request.message }],
+			});
+		}
+
+		return messages;
+	}
+}
+
+function historyResponseToText(response: ReadonlyArray<IChatProgressHistoryResponseContent | IChatTaskDto>): string {
+	let text = '';
+	for (const part of response) {
+		if (part.kind === 'markdownContent') {
+			text += part.content.value;
+		}
+	}
+	return text.trim();
+}
+
+function extractTextChunk(part: unknown): string | undefined {
+	if (Array.isArray(part)) {
+		let text = '';
+		for (const p of part) {
+			if (p && typeof p === 'object' && 'type' in p && (p as { type: string }).type === 'text' && 'value' in p) {
+				text += String((p as { value: string }).value);
+			}
+		}
+		return text || undefined;
+	}
+	if (part && typeof part === 'object' && 'type' in part && (part as { type: string }).type === 'text' && 'value' in part) {
+		return String((part as { value: string }).value);
+	}
+	return undefined;
+}
+
+export function registerLocalCodeChatAgents(instantiationService: IInstantiationService): IDisposable {
+	return instantiationService.invokeFunction(accessor => {
+		const chatAgentService = accessor.get(IChatAgentService);
+		const disposables = new DisposableStore();
+
+		const impl = instantiationService.createInstance(LocalCodeChatAgent);
+
+		const register = (id: string, name: string, isDefault: boolean, description: string, location: ChatAgentLocation, mode: ChatModeKind, themeIcon?: ThemeIcon) => {
+			disposables.add(chatAgentService.registerAgent(id, {
+				id,
+				name,
+				isDefault,
+				isCore: false,
+				modes: [mode],
+				slashCommands: [],
+				disambiguation: [],
+				locations: [location],
+				metadata: { helpTextPrefix: HELP_TEXT },
+				description,
+				extensionId: nullExtensionDescription.identifier,
+				extensionVersion: undefined,
+				extensionDisplayName: nullExtensionDescription.name,
+				extensionPublisherId: nullExtensionDescription.publisher,
+			}));
+			disposables.add(chatAgentService.registerAgentImplementation(id, impl));
+			if (themeIcon) {
+				chatAgentService.updateAgent(id, { themeIcon });
+			}
+		};
+
+		const displayName = localize('localCode.chat.agentName', "Local Code");
+		register(LOCAL_CODE_CHAT_AGENT_IDS.chat, displayName, true, ChatMode.Ask.description.get(), ChatAgentLocation.Chat, ChatModeKind.Ask);
+		register(LOCAL_CODE_CHAT_AGENT_IDS.edits, displayName, true, ChatMode.Edit.description.get(), ChatAgentLocation.Chat, ChatModeKind.Edit);
+		register(LOCAL_CODE_CHAT_AGENT_IDS.agent, displayName, true, ChatMode.Agent.description.get(), ChatAgentLocation.Chat, ChatModeKind.Agent, Codicon.tools);
+		register(LOCAL_CODE_CHAT_AGENT_IDS.terminal, displayName, true, ChatMode.Ask.description.get(), ChatAgentLocation.Terminal, ChatModeKind.Ask);
+		register(LOCAL_CODE_CHAT_AGENT_IDS.editor, displayName, true, ChatMode.Ask.description.get(), ChatAgentLocation.EditorInline, ChatModeKind.Ask);
+		register(LOCAL_CODE_CHAT_AGENT_IDS.notebook, displayName, true, ChatMode.Ask.description.get(), ChatAgentLocation.Notebook, ChatModeKind.Ask);
+
+		return disposables;
+	});
+}

