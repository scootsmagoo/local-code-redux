+
+import { CancellationToken } from '../../../../base/common/cancellation.js';
+import { isMacintosh, isWindows } from '../../../../base/common/platform.js';
+import { URI } from '../../../../base/common/uri.js';
+import { localize } from '../../../../nls.js';
+import { IConfigurationService } from '../../../../platform/configuration/common/configuration.js';
+import { ILogService } from '../../../../platform/log/common/log.js';
+import { INativeHostService } from '../../../../platform/native/common/native.js';
+import { INotificationService, Severity } from '../../../../platform/notification/common/notification.js';
+import { IRequestService } from '../../../../platform/request/common/request.js';
+import product from '../../../../platform/product/common/product.js';
+import { ChatEntitlement, ChatEntitlementContext } from '../../../services/chat/common/chatEntitlementService.js';
+import { ILanguageModelsService } from '../../chat/common/languageModels.js';
+import { OllamaClient, OLLAMA_VENDOR } from './ollamaClient.js';
+import { LocalCodeOllamaSettings } from './ollamaLanguageModelProvider.js';
+
+export const LOCAL_CODE_CONNECT_OLLAMA_COMMAND_ID = 'localCode.connectOllama';
+export const LOCAL_CODE_OPEN_OLLAMA_APP_COMMAND_ID = 'localCode.openOllamaApp';
+
+const OLLAMA_MAC_APP = '/Applications/Ollama.app';
+const OLLAMA_WIN_APP = 'C:\\Program Files\\Ollama\\Ollama.exe';
+
+export async function openOllamaApp(nativeHostService: INativeHostService): Promise<void> {
+	if (isMacintosh) {
+		await nativeHostService.openExternal(URI.file(OLLAMA_MAC_APP).toString(true));
+	} else if (isWindows) {
+		await nativeHostService.openExternal(URI.file(OLLAMA_WIN_APP).toString(true));
+	}
+}
+
+const defaultChatExtensionId = product.defaultChatAgent?.chatExtensionId ?? '';
+
+export function isLocalCodeOllamaMode(): boolean {
+	return !defaultChatExtensionId;
+}
+
+export interface IOllamaConnectResult {
+	readonly ok: boolean;
+	readonly modelNames: readonly string[];
+	readonly errorMessage?: string;
+}
+
+export async function connectToOllama(options: {
+	requestService: IRequestService;
+	logService: ILogService;
+	configurationService: IConfigurationService;
+	languageModelsService: ILanguageModelsService;
+	context: ChatEntitlementContext | undefined;
+	notificationService?: INotificationService;
+	nativeHostService?: INativeHostService;
+	silent?: boolean;
+}): Promise<IOllamaConnectResult> {
+	const endpoint = options.configurationService.getValue<string>(LocalCodeOllamaSettings.endpoint) ?? 'http://127.0.0.1:11434';
+	const timeoutMs = options.configurationService.getValue<number>(LocalCodeOllamaSettings.requestTimeoutMs) ?? 120_000;
+	const client = new OllamaClient(options.requestService, options.logService);
+
+	try {
+		const models = await client.listModels(endpoint, timeoutMs, CancellationToken.None);
+		if (models.length === 0) {
+			const errorMessage = localize('localCode.ollama.noModelsShort', "Ollama is running but no models are installed. In a terminal run: ollama pull <model>");
+			if (!options.silent) {
+				options.notificationService?.notify({ severity: Severity.Warning, message: errorMessage });
+			}
+			return { ok: false, modelNames: [], errorMessage };
+		}
+
+		await options.languageModelsService.selectLanguageModels({ vendor: OLLAMA_VENDOR });
+
+		if (options.context) {
+			await options.context.update({ installed: true, disabled: false, untrusted: false, disabledInWorkspace: false });
+			await options.context.update({ entitlement: ChatEntitlement.Free, organisations: undefined, sku: undefined, copilotTrackingId: undefined });
+			await options.context.update({ completed: true });
+		}
+
+		const modelNames = models.map(m => m.name);
+		if (!options.silent) {
+			options.notificationService?.info(localize(
+				'localCode.ollama.connected',
+				"Connected to Ollama at {0}. {1} model(s) available in the model picker.",
+				endpoint,
+				modelNames.length,
+			));
+		}
+		options.logService.info(`[Local Code] Ollama connected: ${modelNames.join(', ')}`);
+		return { ok: true, modelNames };
+	} catch (err) {
+		const errorMessage = localize(
+			'localCode.ollama.unreachable',
+			"Could not reach Ollama at {0}. Ensure the Ollama app is running (or run `ollama serve`). No sign-in is required.",
+			endpoint,
+		);
+		const detail = err instanceof Error ? err.message : String(err);
+		options.logService.warn(`[Local Code] ${errorMessage}`, detail);
+		if (!options.silent && options.notificationService) {
+			const fullMessage = `${errorMessage} ${detail}`;
+			if ((isMacintosh || isWindows) && options.nativeHostService) {
+				options.notificationService.prompt(
+					Severity.Error,
+					fullMessage,
+					[{
+						label: localize('localCode.openOllamaApp', "Open Ollama"),
+						run: () => openOllamaApp(options.nativeHostService!),
+					}],
+				);
+			} else {
+				options.notificationService.notify({ severity: Severity.Error, message: fullMessage });
+			}
+		}
+		return { ok: false, modelNames: [], errorMessage: `${errorMessage} ${detail}` };
+	}
+}

diff --git a/src/vs/workbench/contrib/localLLM/browser/localCodeChatAgent.ts b/src/vs/workbench/contrib/localLLM/browser/localCodeChatAgent.ts
